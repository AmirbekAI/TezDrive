                "rides",
                "{{rideId}}"
              ]
            }
          }
        },
        {
          "name": "Search Rides (Passenger)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{passengerToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/rides/search?fromCity=Bishkek&toCity=Osh&date=2026-06-01&minSeats=1&maxPrice=600",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "rides",
                "search"
              ],
              "query": [
                {
                  "key": "fromCity",
                  "value": "Bishkek"
                },
                {
                  "key": "toCity",
                  "value": "Osh"
                },
                {
                  "key": "date",
                  "value": "2026-06-01"
                },
                {
                  "key": "minSeats",
                  "value": "1"
                },
                {
                  "key": "maxPrice",
                  "value": "600"
                }
              ]
            }
          }
        },
